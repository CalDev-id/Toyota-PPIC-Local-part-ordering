generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model items {
  id         Int       @id @default(autoincrement())
  name       String    @default("")
  qty        Int       @default(0)
  status     String    @default("")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  price      Int?      @default(0)
}